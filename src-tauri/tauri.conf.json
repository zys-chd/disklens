{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DiskLens",
  "version": "0.1.0",
  "identifier": "dev.disklens.desktop",
  "build": {
    "frontendDist": "../app/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix ../app run dev",
    "beforeBuildCommand": "npm --prefix ../app run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DiskLens",
        "width": 1280,
        "height": 820,
        "minWidth": 980,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}
